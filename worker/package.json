{
  "name": "plantriz-worker",
  "private": true,
  "type": "module",
  "description": "PlanTriz backend as a Cloudflare Worker + D1 (serves the frontend from ../frontend as static assets).",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --host localhost:8787",
    "migrate:local": "wrangler d1 migrations apply plantriz --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ai": "node scripts/smoke-ai.mjs"
  },
  "dependencies": {
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
