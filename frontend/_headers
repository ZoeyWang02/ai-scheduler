# Response headers for the static site (read by Cloudflare Workers static assets; ignored by other servers).
# The API's own headers are set in worker/src/index.ts.
#
# Content-Security-Policy: scripts, workers, fonts and images load from this site only (third-party libraries
# live in /vendor), inline <script> and inline event handlers are not allowed, and the page may only talk to
# this site and to the AI providers a user can pick in Settings. If a script is ever injected into the page it
# can neither load more code nor send what it reads (session token, the user's own AI key) anywhere else.
# style-src keeps 'unsafe-inline' because FullCalendar and Tippy set styles at run time; font-src allows data:
# because FullCalendar embeds its small icon font in the styles it injects.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.groq.com https://api.openai.com https://generativelanguage.googleapis.com https://openrouter.ai https://api.deepseek.com; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Pinned library files never change (the version is in the path).
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
